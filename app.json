{
  "expo": {
    "name": "Toll Balance",
    "slug": "toll-app",
    "owner": "catalyxsolutions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tollapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.catalyx.tollbalance",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Tolly turns what you say into commands like “balances” or “stop”.",
        "NSMicrophoneUsageDescription": "Tolly listens for its name so you can check balances hands-free while driving."
      }
    },
    "android": {
      "package": "com.catalyx.tollbalance",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-app-intents",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tolly listens for its name so you can check balances hands-free while driving.",
          "speechRecognitionPermission": "Tolly turns what you say into commands like “balances” or “stop”."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "281b4bce-f117-4418-8817-5212ab88d392"
      }
    }
  }
}
